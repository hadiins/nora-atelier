# PostgreSQL Connection String
DATABASE_URL="postgresql://nora_user:nora_pass@localhost:5432/nora_store?schema=public"

# App Config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Zarinpal Payment Gateway
ZARINPAL_MERCHANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ZARINPAL_SANDBOX="true"

# Admin Secret Key (برای محافظت از API ادمین)
ADMIN_API_SECRET="change-this-to-a-strong-secret"

# Optional AI Stylist (OpenAI)
OPENAI_API_KEY=""

# Redis URL (for Rate Limiting)
REDIS_URL="redis://localhost:6379"
